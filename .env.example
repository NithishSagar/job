# ---------------------------------------------------------------------------
# JobHunt Command Center - environment variables
# Copy this file to .env.local for local dev, and add the same two variables to
# your Vercel project settings (Settings -> Environment Variables).
#
# NOTE: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time,
# so they must be present in Vercel BEFORE the deploy build runs.
#
# Both values come from Supabase: Project Settings -> API
# ---------------------------------------------------------------------------

# e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" public API key (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL - server-only, never prefix with NEXT_PUBLIC_.
# Only needed if you decide to implement the real account-deletion flow in
# app/api/account/delete/route.ts (it is intentionally stubbed out).
# Treat this key as a root password: it bypasses RLS.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
