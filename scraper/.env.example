# Copy to scraper/.env and fill in. In GitHub Actions these are repo secrets
# (see .github/workflows/daily-scrape.yml).

# Supabase project settings -> API. Use the SERVICE ROLE key: the scraper writes
# on the user's behalf and must bypass RLS. Never expose it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Free key: https://developer.adzuna.com/signup
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Free key: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=your-reed-api-key

# Optional. Leave unset and the scraper uses the 'owner' row in `users`.
# Set it only if you have several rows and want to target one.
# SCRAPER_USER_ID=00000000-0000-0000-0000-000000000000
